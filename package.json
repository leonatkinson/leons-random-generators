{
  "name": "leons-random-generators",
  "version": "1.0.0",
  "private": true,
  "description": "Leon's Random Generators as Gutenberg blocks",
  "type": "module",
  "scripts": {
    "build": "wp-scripts build --config webpack.config.cjs",
    "start": "wp-scripts start --config webpack.config.cjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "generate": "node src/cli.js",
    "build-dictionary": "node scripts/csv-to-json.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "@wordpress/scripts": "^36.1.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  }
}
